{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "tester.html",
      "use": "@vercel/static"
    },
    {
      "src": "rci.html",
      "use": "@vercel/static"
    },
    {
      "src": "commission-factory-8284114c9b1b491b949e8d9534dfd1b5.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/recommend.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/feedback.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/email.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/click.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/autocomplete.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/recommend",
      "dest": "/api/recommend.js"
    },
    {
      "src": "/api/feedback",
      "dest": "/api/feedback.js"
    },
    {
      "src": "/api/email",
      "dest": "/api/email.js"
    },
    {
      "src": "/api/click",
      "dest": "/api/click.js"
    },
    {
      "src": "/api/autocomplete",
      "dest": "/api/autocomplete.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js",
      "headers": { "Service-Worker-Allowed": "/" }
    },
    {
      "src": "/tester",
      "dest": "/tester.html"
    },
    {
      "src": "/tester.html",
      "dest": "/tester.html"
    },
    {
      "src": "/rci",
      "dest": "/rci.html"
    },
    {
      "src": "/rci.html",
      "dest": "/rci.html"
    },
    {
      "src": "/commission-factory-8284114c9b1b491b949e8d9534dfd1b5.html",
      "dest": "/commission-factory-8284114c9b1b491b949e8d9534dfd1b5.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
